{
  "name": "@kubohiroya/vite-plugin-turbowarp-extension",
  "version": "0.9.0",
  "description": "A Vite plugin for building TypeScript projects as single-file TurboWarp extensions.",
  "type": "module",
  "license": "MPL-2.0",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/vite-plugin-turbowarp-extension.git"
  },
  "homepage": "https://github.com/kubohiroya/vite-plugin-turbowarp-extension#readme",
  "bugs": {
    "url": "https://github.com/kubohiroya/vite-plugin-turbowarp-extension/issues"
  },
  "keywords": [
    "vite",
    "turbowarp",
    "scratch",
    "extension",
    "plugin",
    "typescript"
  ],
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.8",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run repo:check && pnpm run pack:check"
  },
  "dependencies": {
    "acorn": "^8.18.0"
  },
  "peerDependencies": {
    "vite": ">=8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
