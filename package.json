{
  "name": "@kubohiroya/vite-plugin-turbowarp-extension",
  "version": "0.2.0",
  "description": "A Vite plugin for building TypeScript projects as single-file TurboWarp extensions.",
  "type": "module",
  "license": "MPL-2.0",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/vite-plugin-turbowarp-extension.git"
  },
  "homepage": "https://github.com/kubohiroya/vite-plugin-turbowarp-extension#readme",
  "bugs": {
    "url": "https://github.com/kubohiroya/vite-plugin-turbowarp-extension/issues"
  },
  "keywords": [
    "vite",
    "turbowarp",
    "scratch",
    "extension",
    "plugin",
    "typescript"
  ],
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "npm@11.19.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "repo:check": "node scripts/check-repo.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "npm run typecheck && npm run test && npm run build && npm run repo:check && npm run pack:check"
  },
  "dependencies": {
    "acorn": "^8.18.0"
  },
  "peerDependencies": {
    "vite": ">=6.0.0"
  },
  "devDependencies": {
    "rollup": "^4.62.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
